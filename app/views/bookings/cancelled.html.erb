<turbo-frame id="dashboard_content">
  <h2 class="text-2xl font-semibold mb-4">Cancelled Bookings</h2>

  <% if @bookings.any? %>
  <div class="space-y-4">
    <% @bookings.each do |booking| %>
    <div class="border p-4 rounded shadow bg-gray-100">
      <p><strong>Destination:</strong> <%= booking.schedule.destination.name %></p>
      <p><strong>Bus:</strong> <%= booking.schedule.bus.name %></p>
      <p><strong>Seats:</strong> <%= booking.seats %></p>
      <p><strong>Total:</strong> ₹<%= booking.total_price %></p>
      <p><strong>Pickup point:</strong> <%= booking.pickup %></p>
      <p><strong>Departure:</strong> <%= booking.schedule.departure %></p>
      <p><strong>Drop point:</strong> <%= booking.drop %></p>
      <p><strong>Arrival:</strong> <%= booking.schedule.arrival %></p>
      <p class="text-red-600 font-semibold">Cancelled</p>
    </div>
    <% end %>
  </div>
  <% else %>
  <p>No cancelled bookings found.</p>
  <% end %>
</turbo-frame>