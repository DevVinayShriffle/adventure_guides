<%= form_with(model: [:admin, @destination],
              data: { turbo_frame: "dashboard_content" },
              class: "space-y-4") do |f| %>

  <div>
    <%= f.label :name, class: "block font-medium" %>
    <%= f.text_field :name, class: "w-full border p-2 rounded" %>
  </div>

  <div>
    <%= f.label :location, class: "block font-medium" %>
    <%= f.text_field :location, class: "w-full border p-2 rounded" %>
  </div>

  <div>
    <%= f.label :description, class: "block font-medium" %>
    <%= f.text_area :description, class: "w-full border p-2 rounded" %>
  </div>

  <div>
    <%= f.label :images, class: "block font-medium" %>
    <%= f.file_field :images, multiple: true, class: "w-full border p-2 rounded" %>
  </div>

  <div>
    <%= f.submit class: "bg-black text-white px-4 py-2 rounded hover:bg-gray-800" %>
  </div>

<% end %>