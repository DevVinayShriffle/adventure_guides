<turbo-frame id="dashboard_content">
  <h1 class="text-2xl font-bold mb-4"><%= @destination.name %></h1>

  <p class="mb-2 text-gray-600">
    <strong>Location:</strong> <%= @destination.location %>
  </p>

  <p class="mb-4">
    <strong>Description:</strong>
    <%= @destination.description %>
  </p>

  <% if @destination.images.attached? %>
    <div class="grid grid-cols-3 gap-4 mt-4">
      <% @destination.images.each do |image| %>
        <%= image_tag image, class: "rounded shadow" %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= link_to "Back",
                admin_destinations_path,
                data: { turbo_frame: "dashboard_content" },
                class: "text-blue-600" %>
  </div>
</turbo-frame>