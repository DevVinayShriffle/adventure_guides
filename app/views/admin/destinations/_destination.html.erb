<div class="border p-4 rounded shadow bg-white">

  <% if destination.images.attached? %>
  <!-- Controller definition, target container, and scroll action -->
  <div data-controller="auto-scroll" class="w-full ">
    <div data-auto-scroll-target="container" class="flex overflow-x-hidden snap-x snap-mandatory scroll-smooth gap-2">
      <% destination.images.each do |image| %>
      <%= image_tag(image, class: "rounded-lg h-30") %>
      <% end %>
    </div>
  </div>
  <% else %>
  <p>No images attached.</p>
  <% end %>

  <h2 class="text-lg font-medium truncate w-48"><%= destination.name %></h2>

  <p class="text-sm text-gray-600 truncate w-48">
    <%= destination.location %>
  </p>

  <p class="text-sm my-2 truncate w-48">
    <%= destination.description %>
  </p>

  <div class="flex justify-between items-center">
    <%= link_to "View",
    admin_destination_path(destination),
    data: { turbo_frame: "dashboard_content" },
    class: "px-3 py-1.5 rounded-md text-sm font-medium bg-sky-50 text-sky-700 hover:bg-sky-100" %>

    <%= link_to "Edit",
    edit_admin_destination_path(destination),
    data: { turbo_frame: "dashboard_content" },
    class: "px-3 py-1.5 rounded-md text-sm font-medium bg-amber-50 text-amber-700 hover:bg-amber-100" %>

    <%= link_to "Delete",
    admin_destination_path(destination),
    data: { confirm: "Are you sure?", turbo_method: :delete },
    class: "px-3 py-1.5 rounded-md text-sm font-medium bg-rose-50 text-rose-700 hover:bg-rose-100" %>
  </div>

</div>