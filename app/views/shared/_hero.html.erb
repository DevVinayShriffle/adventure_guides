<div data-controller="toggle" class="w-full flex justify-between items-center px-20 py-3 border-b-1 border-gray-300 h-[12vh] shadow-xl/10">

  <!-- LOGO -->
  <div class="flex justify-center items-center gap-2 cursor-pointer"
  data-controller="redirect" 
  data-action="click->redirect#redirectToUrl" 
  data-redirect-url-value="<%= destinations_path %>">
    <div class="border p-2 rounded-full">
      <p class="font-bold text-2xl">AG</p>
    </div>
    <div class="flex gap-2">
      <span class="font-medium font-xl">ADVENTURE</span>
      <p class="font-light">Guides</p>
    </div>
  </div>

  <div class="fixed left-0 w-full flex justify-center items-center">
    <div id="flash-messages">
      <!--
      <div class="bg-green-100 text-green-800 border-green-400 rounded-full">
      -->
      <%= render "shared/flash_messages" %>
      <!--
      </div>
      -->
    </div>
  </div>

  <!-- MENU ICON -->
  <div data-action="click->toggle#toggle">
    <i class="ri-menu-fill font-bold text-lg"></i>
  </div>

  <!-- AUTH LINKS -->
  <div data-toggle-target="dropdown" class="flex flex-col gap-2 bg-gray-300 absolute right-10 top-13 z-10 rounded p-2 border-1 border-gray-400 hidden">

    <% if user_signed_in? %>

    <!-- When User Logged In -->
    <%= link_to "Dashboard", dashboard_path, class: "font-medium hover:text-blue-500" %>

    <%= link_to "Logout",
    destroy_user_session_path,
    data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
    class: "font-medium text-red-500 hover:text-red-700" %>

    <% else %>

    <!-- When User NOT Logged In -->
    <%= link_to "Sign Up",
    new_user_registration_path,
    class: "font-medium hover:text-blue-500" %>

    <%= link_to "Login",
    user_session_path,
    class: "font-medium hover:text-blue-500" %>

    <% end %>

  </div>

</div>