<div class="flex flex-col" id="<%= dom_id destination %>">
  <div>images</div>
  <% if destination.images.attached? %>
    <div class="image-gallery">
      <% destination.images.each do |image| %>
        <%= image_tag(image, class: "product-image") %>
      <% end %>
    </div>
  <% else %>
    <p>No images attached.</p>
  <% end %>

  <%= destination.name %>
  <%= destination.description %>
  <%= destination.location %>
  <%= link_to 'Check Buses', destination_buses_path(destination.id), class: 'table-action edit' %>

    
</div>

<div class="border p-4 rounded shadow bg-white">

  <% if destination.images.attached? %>
    <%= image_tag destination.images.first,
          class: "w-full h-40 object-cover rounded mb-3" %>
  <% else %>
    <div class="w-full h-40 bg-gray-200 flex items-center justify-center mb-3">
      No Image
    </div>
  <% end %>

  <h2 class="text-lg font-medium"><%= destination.name %></h2>

  <p class="text-sm text-gray-600">
    <%= destination.location %>
  </p>

  <p class="text-sm my-2">
    <%= destination.description %>
  </p>

  <%= link_to "Check Buses",
      destination_buses_path(destination),
      class: "inline-block mt-2 px-4 py-2 bg-black text-white rounded" %>

</div>

<div class="border p-5 rounded-lg shadow-sm flex flex-col gap-3">

  <% if destination.images.attached? %>
    <%= image_tag destination.images.first, class: "w-full h-40 object-cover rounded" %>
  <% else %>
    <div class="w-full h-40 bg-gray-200 flex items-center justify-center">
      No Image
    </div>
  <% end %>

  <p class="text-lg font-semibold"><%= destination.name %></p>
  <p class="text-sm text-gray-500"><%= destination.location %></p>

  <%= link_to "Check Buses",
      destination_buses_path(destination),
      class: "mt-3 bg-black text-white text-center py-2 rounded" %>

</div>