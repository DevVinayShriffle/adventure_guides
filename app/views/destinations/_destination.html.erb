<div class="border p-4 rounded shadow bg-white">

  <% if destination.images.attached? %>
    <!-- Controller definition, target container, and scroll action -->
    <div data-controller="auto-scroll" class="w-full ">
      <div data-auto-scroll-target="container" class="flex overflow-x-hidden snap-x snap-mandatory scroll-smooth gap-2">
        <% destination.images.each do |image| %>
          <%= image_tag(image, class: "rounded-lg") %>
        <% end %>
      </div>
    </div>
  <% else %>
    <p>No images attached.</p>
  <% end %>

  <h2 class="text-lg font-medium"><%= destination.name %></h2>

  <p class="text-sm text-gray-600">
    <%= destination.location %>
  </p>

  <p class="text-sm my-2">
    <%= destination.description %>
  </p>

  <%= link_to "Check Buses",
      destination_buses_path(destination),
      class: "inline-block mt-2 px-4 py-2 bg-black text-white rounded" %>

</div>

<div class="border p-5 rounded-lg shadow-sm flex flex-col gap-3">

  <% if destination.images.attached? %>
    <!-- Controller definition, target container, and scroll action -->
    <div data-controller="auto-scroll" class="w-full ">
      <div data-auto-scroll-target="container" class="flex overflow-x-hidden snap-x snap-mandatory scroll-smooth gap-2">
        <% destination.images.each do |image| %>
          <%= image_tag(image, class: "rounded-lg") %>
        <% end %>
      </div>
    </div>
  <% else %>
    <p>No images attached.</p>
  <% end %>

  <p class="text-lg font-semibold"><%= destination.name %></p>
  <p class="text-sm text-gray-500"><%= destination.location %></p>

  <%= link_to "Check Buses",
      destination_buses_path(destination),
      class: "mt-3 bg-black text-white text-center py-2 rounded" %>

</div>