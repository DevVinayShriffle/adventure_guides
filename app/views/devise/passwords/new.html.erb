<div class="flex justify-center items-center h-[80vh]">
  <div class="w-96 border p-6 rounded shadow">
    <h2 class="text-xl font-semibold mb-4">Forgot your password?</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, data: { turbo: false } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="required-field mb-2">
        <p><%= f.label :email %></p>
        <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full border p-2 rounded" %></p>
      </div>

      <div class="actions">
        <%= f.submit "Send me password reset instructions", class: "w-full bg-black text-white py-2 rounded" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
</div>
</div>