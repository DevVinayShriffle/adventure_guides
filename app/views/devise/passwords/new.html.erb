<div class="flex justify-center items-center h-[80vh]">
  <div class="w-96 border p-6 rounded shadow">
    <h2 class="text-xl font-semibold mb-4">Forgot your password?</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, data: { turbo: false, controller: "form-validation", action: "submit->form-validation#validate" } }) do |f| %>

      <div class="required-field mb-2">
        <p><%= f.label :email %></p>
        <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full border p-2 rounded", data: { form_validation_target: "input", field: "email" } %></p>
        <p class="text-red-500 text-sm mt-1"
          data-form-validation-target="error"
          data-field="email"></p>
        <% if resource.errors.any? %>
          <div class="text-red-500 text-sm">
            <%= resource.errors.full_messages.first %>
          </div>
        <% end %>
      </div>


      <div class="actions">
        <%= f.submit "Send me password reset instructions", class: "w-full bg-black text-white py-2 rounded" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
</div>
</div>