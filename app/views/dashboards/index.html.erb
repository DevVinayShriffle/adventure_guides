<% content_for :hide_footer, true %>

<div class="flex h-[88vh]">

  <!-- LEFT SIDEBAR -->
  <div class="w-1/5 bg-gray-100 border-r p-6">
    <h2 class="text-xl font-bold ml-[10%] mb-6">Dashboard</h2>

    <ul class="space-y-4">
      <li>
        <% if false %>
        <turbo-frame id="sidebar_avatar">
          <div class="mb-4 ml-[10%]">
            <% if @user.avatar.attached? %>
            <%= image_tag @user.avatar,
            class: "w-24 h-24 rounded-full object-cover mb-2" %>
            <% end %>
          </div>
        </turbo-frame>
        <% end %>

        <%= render "dashboards/sidebar_avatar", user: @user %>
      </li>
      <% @options.each do |option| %>
      <li>
        <%= link_to option[:name],
        option[:path],
        data: { turbo_frame: "dashboard_content" },
        class: "block px-4 py-2 rounded hover:bg-gray-200 transition" %>
      </li>
      <% end %>
    </ul>
  </div>

  <!-- RIGHT CONTENT AREA -->
  <div class="w-4/5 p-8 overflow-y-auto">
    <% if false %>
    <!-- Flash container -->
    <div id="dashboard_flash"
        class="fixed top-16 right-10 z-50 w-96">
      <%= render "shared/flash_messages" %>
    </div>
    <% end %>

    <turbo-frame id="dashboard_content">

      <h2 class="text-2xl font-semibold text-gray-600">
        Welcome <%= @user.name %>
      </h2>
      <p class="mt-2 text-gray-500">
        Select an option from the left panel.
      </p>
    </turbo-frame>
  </div>

</div>