<div class="flex justify-center items-center mt-15">
  <div class="w-96 border p-6 rounded shadow">

    <h2 class="text-xl font-semibold mb-4">Sign Up</h2>

    <%= form_for(resource, as: resource_name, 
      url: registration_path(resource_name),
      html: { data: { controller: "form-validation", action: "submit->form-validation#validate" } }) do |f| %>

      <div class="required-field mb-4">
        <%= f.label :name %>
        <%= f.text_field :name,
        class: "w-full border p-2 rounded",
          data: { form_validation_target: "input", field: "name" }, autofocus: true %>
        <p class="text-red-500 text-sm mt-1"
          data-form-validation-target="error"
          data-field="name"></p>
      </div>

      <div class="required-field mb-4">
        <%= f.label :email %>
        <%= f.email_field :email,
        class: "w-full border p-2 rounded",
          data: { form_validation_target: "input", field: "email" } %>
        <p class="text-red-500 text-sm mt-1"
          data-form-validation-target="error"
          data-field="email"></p>
      </div>

      <div class="mb-4">
        <%= f.label :phone, class: "block font-medium mb-2" %>
        <%= f.text_field :phone,
        class: "w-full border p-2 rounded" %>
      </div>

      <div class="mb-4">
        <%= f.label :avatar, class: "block font-medium mb-2" %>
        <%= f.file_field :avatar,
        class: "w-full border p-2 rounded" %>
      </div>

      <div class="mb-4">
        <%= f.label :role %>
        <%= f.select :role,
        User.roles.keys.reject { |r| r == "admin" }.map { |r| [r.capitalize, r] },
        { selected: "tourist" },
        class: "w-full border p-2 rounded" %>
      </div>

      <div class="required-field mb-4">
        <%= f.label :password %>
        <%= f.password_field :password,
        class: "w-full border p-2 rounded",
          data: { form_validation_target: "input", field: "password" } %>
        <p class="text-red-500 text-sm mt-1"
          data-form-validation-target="error"
          data-field="password"></p>
      </div>

      <%= f.submit "Sign Up",
      class: "w-full bg-black text-white py-2 rounded" %>

    <% end %>
  </div>
</div>