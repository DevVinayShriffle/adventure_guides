<%= form_with(model: [:guide, @bus, @bus_stop],
  data: { turbo_frame: "dashboard_content" },
  class: "space-y-4") do |f| %>

  <div>
    <%= f.label :name, class: "block font-medium" %>
    <%= f.text_field :name, class: "w-full border p-2 rounded" %>
  </div>

  <%= f.select :stop_type, 
  options_for_select(['pickup', 'drop'], f.object.stop_type), 
  { include_blank: 'Select Bus stop type' }, 
  class: 'w-full border p-2 rounded' %>

  <div class="flex gap-5">
    <%= f.submit class: "bg-black text-white px-4 py-2 rounded hover:bg-gray-800" %>

    <%= link_to "Back",
    guide_buses_path,
    data: { turbo_frame: "dashboard_content" },
    class: "bg-black text-white px-4 py-2 rounded hover:bg-gray-800" %>
  </div>

  <% end %>