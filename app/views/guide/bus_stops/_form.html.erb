<%= form_with(model: [:guide, @bus, @bus_stop],
  data: { turbo_frame: "dashboard_content" },
  class: "space-y-4") do |f| %>

  <div>
    <%= f.label :name, class: "block font-medium" %>
    <%= f.text_field :name, class: "w-full border p-2 rounded" %>
  </div>

  <%= f.select :stop_type, 
  options_for_select(['pickup', 'drop'], f.object.stop_type), 
  { include_blank: 'Select Bus stop type' }, 
  class: 'w-full border p-2 rounded' %>

  <div class="flex gap-5">
    <%= f.submit class: "bg-black text-white px-4 py-2 rounded hover:bg-gray-800" %>

    <%= link_to "Back",
    guide_buses_path,
    data: { turbo_frame: "dashboard_content" },
    class: "bg-black text-white px-4 py-2 rounded hover:bg-gray-800" %>
  </div>

  <% end %>

  <% if false %>
    <turbo-frame id="dashboard_content">
      <div class="bg-white p-6 rounded shadow w-1/2">

        <h2 class="text-xl font-semibold mb-4">
          <%= @bus_stop.new_record? ? "Add Bus Stop" : "Edit Bus Stop" %>
        </h2>

        <%= form_with(model: [:guide, @bus, @bus_stop]) do |f| %>

          <div class="mb-4">
            <%= f.label :name, class: "block mb-1 font-medium" %>
            <%= f.text_field :name, class: "w-full border p-2 rounded" %>
          </div>

          <div class="mb-4">
            <%= f.label :stop_type, class: "block mb-1 font-medium" %>
            <%= f.select :stop_type,
                  [["Pickup", "pickup"], ["Drop", "drop"]],
                  {},
                  class: "w-full border p-2 rounded" %>
          </div>

          <div class="flex gap-4">
            <%= f.submit class: "px-4 py-2 bg-purple-600 text-white rounded" %>

            <%= link_to "Back",
                guide_bus_path(@bus),
                class: "px-4 py-2 bg-gray-300 rounded" %>
          </div>

        <% end %>

      </div>
    </turbo-frame>
  <% end %>