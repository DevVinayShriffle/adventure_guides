<turbo-frame id="dashboard_content">
  <div class="flex items-center gap-3 mb-3">
  <h1 class="text-2xl font-bold">Your Buses</h1>
  <%= link_to "Create Bus",
  new_guide_bus_path,
  data: { turbo_frame: "dashboard_content" },
  class: "bg-black text-white px-4 py-2 rounded hover:bg-gray-800" %>
  </div>

  <%#= link_to "Back",
  dashboard_path,
  data: { turbo_frame: "dashboard_content" },
  class: "bg-blue-200 text-black px-4 py-2 rounded hover:bg-blue-400 hover:text-white fixed top-20 right-20" %>

  <!-- Modern Back Button -->
    <div class="fixed top-25 right-[5%]">
      <%= link_to dashboard_path,
      data: { turbo_frame: "dashboard_content" },
      class: "flex items-center gap-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-full shadow-sm transition" do %>
      ← Back
      <% end %>
    </div>

  <div id="buses" class="grid grid-cols-3 gap-6">
    <% if @buses.present? %>
    <%= render @buses %>
    <% else %>
    <p>No Buses Available</p>
    <% end %>
  </div>
</turbo-frame>